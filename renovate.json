{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Paris",
  "labels": [
    "dependencies"
  ],
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Image de base du Dockerfile : correctifs (souvent de sécurité) appliqués sans attendre, avec une release",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "automerge": true
    },
    {
      "description": "Outils de développement : regroupés une fois par semaine, mergés si la CI passe",
      "matchDepTypes": [
        "dev-packages"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dev dependencies",
      "schedule": [
        "before 6am on monday"
      ],
      "automerge": true
    },
    {
      "description": "Dépendances : regroupées une fois par semaine, relues avant le merge (elles déclenchent une release)",
      "matchManagers": [
        "pip_requirements",
        "pipenv"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dependencies",
      "schedule": [
        "before 6am on monday"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Actions GitHub : regroupées une fois par semaine",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "schedule": [
        "before 6am on monday"
      ],
      "automerge": true
    },
    {
      "description": "aiobotocore : les paquets qu'il épingle montent avec lui dans une seule PR",
      "matchPackageNames": [
        "aiobotocore",
        "botocore",
        "boto3",
        "aiohttp",
        "aioitertools",
        "multidict",
        "python-dateutil",
        "yarl"
      ],
      "groupName": "aiobotocore",
      "separateMajorMinor": false,
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "botocore : borné par aiobotocore (3.10.0 : <1.43.118), borne à relever avec lui",
      "matchPackageNames": [
        "botocore"
      ],
      "allowedVersions": "<1.43.118"
    },
    {
      "description": "python-dateutil : aiobotocore exige une version <3",
      "matchPackageNames": [
        "python-dateutil"
      ],
      "allowedVersions": "<3"
    },
    {
      "description": "aiodns et pycares dans une seule PR, aiodns v4 exigeant pycares >=5",
      "matchPackageNames": [
        "aiodns",
        "pycares"
      ],
      "groupName": "aiodns",
      "separateMajorMinor": false,
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Image Python : pas de 3.15, zstandard n'a pas de roue pour cette version et l'image de build n'a pas de compilateur",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.1[1-4]/"
    }
  ]
}
